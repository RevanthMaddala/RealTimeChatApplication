PORT=4000
NODE_ENV=development
# Origin of the React app (only needed when the client is served from a different origin)
CLIENT_ORIGIN=http://localhost:5173
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
DATA_FILE=./data/db.json
# Public URL of the app, used in links sent by email (defaults to CLIENT_ORIGIN)
APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Outgoing email for password resets. Required in production; in development,
# leaving SMTP_HOST empty prints emails to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Relay <no-reply@example.com>
